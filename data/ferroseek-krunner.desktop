# SPDX-License-Identifier: GPL-3.0-or-later
# KRunner D-Bus runner metadata (keys verified against KRunner 6.31,
# see docs/RESEARCH.md §10.3). Installed to
# ~/.local/share/krunner/dbusplugins/ferroseek.desktop
[Desktop Entry]
Type=Service
Name=FerroSeek File Search
Comment=Find files and folders by name with FerroSeek
Icon=system-search
X-KDE-PluginInfo-Name=ferroseek
X-KDE-PluginInfo-EnabledByDefault=true
X-KDE-PluginInfo-License=GPL-3.0-or-later
X-KDE-PluginInfo-Version=@VERSION@
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=io.github.ferroseek.FerroSeek
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
X-Plasma-Runner-Unique-Results=true
X-Plasma-Runner-Weak-Results=true
